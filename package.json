{
  "name": "thug2-thps3-level-converter",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "THUG2 THPS3 Level Converter: Tony Hawk's Pro Skater 3 (PC) levels converted to Tony Hawk's Underground 2's formats.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-thps3-level-converter.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "commands": [
    "thps3_levels/collfix.ts",
    "thps3_levels/migrate_layouts.ts",
    "thps3_levels/thps3_levels.ts",
    "thps3_levels/thugpro_compare.ts",
    "thps3_levels/thugpro_inventory.ts"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#94e666ceb594a210bbb308f62915827c6d4bab5c",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#a3fcf940c80a681ff88f8af5db49fffc76d39535"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
